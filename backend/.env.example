# Twilio Configuration
# Get your free account at: https://www.twilio.com/console

# Your Twilio Account SID
TWILIO_ACCOUNT_SID=your_account_sid_here

# Your Twilio Auth Token
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio Phone Number (for sending SMS)
# Example: +1234567890 or +919876543210 (for India)
TWILIO_PHONE_NUMBER=+918291818710

# Your Personal Mobile Number (Where you will receive notifications)
# Example: +1234567890 or +919876543210 (for India)
OWNER_PHONE_NUMBER=+918291818710

# Server Port
PORT=3001

# Email Configuration (for sending emails to yourself)
# Get an App Password from your Google Account settings
EMAIL_USER=kashishyadav6768@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password
